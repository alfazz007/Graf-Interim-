{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    { "source": "/home", "destination": "/", "permanent": true },
    { "source": "/startseite", "destination": "/", "permanent": true },
    { "source": "/effektive-produktivitaetssteigerung-und-kostensenkung-bei-veraenderten-wettbewerbsbedingungen-zur-wiederherstellung-der-internationalen-wettbewerbsfaehigkeit", "destination": "/", "permanent": true },
    { "source": "/buchung", "destination": "/kontakt/", "permanent": true },
    { "source": "/interim-manager-seminar", "destination": "/interim-leistungen/", "permanent": true },
    { "source": "/author/:path*", "destination": "/ueber-mich/", "permanent": true },
    { "source": "/category/:path*", "destination": "/blog/", "permanent": true },
    { "source": "/tag/:path*", "destination": "/blog/", "permanent": true },
    { "source": "/feed", "destination": "/blog/", "permanent": false },
    { "source": "/comments/feed", "destination": "/blog/", "permanent": false },
    { "source": "/wp-admin/:path*", "destination": "/", "permanent": false },
    { "source": "/wp-login.php", "destination": "/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src 'self'; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests" }
      ]
    },
    {
      "source": "/(images|videos|_astro)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
