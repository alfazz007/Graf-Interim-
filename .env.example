# Contact form (Vercel → Project → Settings → Environment Variables)
# 1. Create a free account at https://resend.com and verify the domain graf-interim.de
# 2. Create an API key and paste it here
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Sender address on the verified domain
CONTACT_FROM_EMAIL=Graf Interim Website <website@graf-interim.de>
# Where enquiries are delivered
CONTACT_TO_EMAIL=graf@graf-interim.de
