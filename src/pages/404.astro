---
import Base from '../layouts/Base.astro';
import { routes } from '../lib/i18n';
---
<Base lang="de" title="Seite nicht gefunden | Graf Interim" description="Die gesuchte Seite existiert nicht (mehr)." alt={routes.home} noindex>
  <section class="ph nf">
    <div class="grid-l" aria-hidden="true"></div>
    <canvas class="viz" data-viz="rings" aria-hidden="true"></canvas>
    <div class="wrap">
      <div class="eb mono rv">Fehler 404 · Error 404</div>
      <h1 class="rvl"><span class="ln"><span>Seite nicht</span></span><span class="ln" style="--i:1"><span><span class="sf">gefunden.</span></span></span></h1>
      <p class="lead rv">Die gesuchte Seite existiert nicht (mehr). Vielleicht hilft Ihnen einer dieser Links weiter. · The page you are looking for does not exist.</p>
      <div class="links rv">
        <a href="/">Startseite</a><a href="/interim-leistungen/">Leistungen</a><a href="/blog/">Blog</a><a href="/kontakt/">Kontakt</a><a href="/en/">English</a>
      </div>
    </div>
  </section>
</Base>
