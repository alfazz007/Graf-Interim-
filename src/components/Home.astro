  </div></div>
  <div class="wrap ct-g">
    <div class="ct-l">
      <div class="tag mono rv">(09) {t('Kontakt', 'Contact')}</div>
      <p class="lead rv">{t('Vertraulich, unverbindlich und auf Augenhöhe. Ich melde mich in der Regel innerhalb von 24 Stunden.', 'Confidential, no obligation, on equal terms. I usually reply within 24 hours.')}</p>
      <a class="circ mg rv" href={`mailto:${contact.email}`} aria-label={t('E-Mail schreiben', 'Write an email')}>
        <svg viewBox="0 0 190 190" aria-hidden="true"><defs><path id="cp" d="M95,95 m-74,0 a74,74 0 1,1 148,0 a74,74 0 1,1 -148,0" /></defs><text><textPath href="#cp">Graf Interim · Interim Management · Consulting ·</textPath></text></svg>
